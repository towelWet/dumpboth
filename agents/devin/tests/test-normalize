#!/bin/bash
# test-normalize — normalize-messages.py must strip noise and drop repeats exactly as fixture says.
# Why: fixtures are synthetic; diff exits nonzero on any drift, so script cannot pass on nothing.
# NEVER DELETE COMMENTS — explain every non-obvious line.
# Update comments with the code; do not strip them.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
if diff <("$HERE/../normalize-messages.py" < "$HERE/fixtures/sample-raw.jsonl") "$HERE/fixtures/sample-normalized.jsonl"; then
  echo PASS
else
  echo FAIL; exit 1
fi
