#!/bin/bash
# export — Orchestrate Devin dump pipeline, allocate oldchatN#, write to ~/Old Chats.
set -uo pipefail

APPEND_SUFFIX="${1:-}"
LIB="$(cd "$(dirname "$0")" && pwd)"

# 1. Locate database
DB=$("$LIB/locate-db") || exit 1

# 2. Select EXACT session: DEVIN_WANT_ID (from `id <ID>` arg) else DEVIN_SESSION_ID env. Never newest.
SESSION_JSON=$("$LIB/select-session.py" "$DB" "${DEVIN_WANT_ID:-${DEVIN_SESSION_ID:-}}") || exit 1
SESSION_ID=$(echo "$SESSION_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['id'])")
MODEL=$(echo "$SESSION_JSON"     | python3 -c "import sys,json; print(json.load(sys.stdin).get('model','') or '')")
TITLE=$(echo "$SESSION_JSON"     | python3 -c "import sys,json; print(json.load(sys.stdin).get('title','') or '')")

# 3. Number allocation
# DEVIN_OUTDIR lets the caller (dumpchat-devin/dumpboth) redirect output to a chosen
# "Old Chats" dir (e.g. pwd/Old Chats vs ~/Old Chats). Defaults to ~/Old Chats.
OUTDIR="${DEVIN_OUTDIR:-$HOME/Old Chats}"; mkdir -p "$OUTDIR"
if [ -n "${DUMP_FORCE_NUM:-}" ]; then
  # /dumpboth forces md+jsonl onto the IDENTICAL number in one dump — no scan race.
  NEXT="$DUMP_FORCE_NUM"
else
  # SHARED counter with the .jsonl dumps — scan BOTH extensions so md and jsonl
  # advance the same oldchatN sequence (matches dumpchat.command/dumpjsonl.command).
  NEXT=0
  for f in "$OUTDIR"/oldchat*.md "$OUTDIR"/oldchat*.jsonl; do
    [ -f "$f" ] || continue
    N=$(basename "$f" | sed 's/oldchat\([0-9]*\).*/\1/')
    [ "$N" -ge "$NEXT" ] 2>/dev/null && NEXT=$N
  done
  NEXT=$((NEXT + 1))
fi

[ -n "$APPEND_SUFFIX" ] && FNAME="oldchat${NEXT}-${APPEND_SUFFIX}.md" || FNAME="oldchat${NEXT}.md"
export_file="$OUTDIR/$FNAME"

# 4. Pipeline: read → normalize → render → footer
"$LIB/read-messages.py" "$DB" "$SESSION_ID" \
  | "$LIB/normalize-messages.py" \
  | "$LIB/render-markdown.py" --model "$MODEL" --title "$TITLE" --dir "$(pwd)" \
  > "$export_file"

# Append resume line
echo "" >> "$export_file"
echo "Resume: devin ls --select $SESSION_ID" >> "$export_file"
echo "Session: $SESSION_ID" >> "$export_file"

echo "$export_file"
