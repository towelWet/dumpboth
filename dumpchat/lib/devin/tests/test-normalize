#!/bin/bash
# test-normalize — Verify normalize-messages.py strips noise correctly.
set -uo pipefail

LIB="$(cd "$(dirname "$0")/.." && pwd)"
FIXTURES="$LIB/tests/fixtures"

errors=0

output=$(cat "$FIXTURES/sample-raw.jsonl" | "$LIB/normalize-messages.py")

# Count lines
out_lines=$(echo "$output" | wc -l | tr -d ' ')
exp_lines=$(wc -l < "$FIXTURES/sample-normalized.jsonl" | tr -d ' ')

if [ "$out_lines" -ne "$exp_lines" ]; then
    echo "FAIL line count: expected $exp_lines, got $out_lines"
    errors=$((errors + 1))
fi

# Line-by-line diff
paste <(echo "$output") "$FIXTURES/sample-normalized.jsonl" | while IFS=$'\t' read -r got expected; do
    if [ "$got" != "$expected" ]; then
        echo "FAIL"
        echo "  expected: $expected"
        echo "  got:      $got"
        exit 1
    fi
done

if [ "$errors" -eq 0 ]; then
    echo "PASS ($exp_lines lines, all match)"
else
    echo "FAIL: $errors errors"
    exit 1
fi
